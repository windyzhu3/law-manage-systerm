        "nodes": [
          {
            "key": "td003",
            "type": "TASK",
            "templateCode": "TD-003",
            "templateVersionId": 3
          },
          {
            "key": "retryResult",
            "type": "DECISION"
          },
          {
            "key": "td004",
            "type": "TASK",
            "templateCode": "TD-004",
            "templateVersionId": 4
          },
          {
            "key": "end",
            "type": "END"
          }
        ],
        "edges": [
          {
            "key": "td003-result",
            "from": "td003",
            "to": "retryResult",
            "priority": 0
          },
          {
            "key": "retry-connected",
            "from": "retryResult",
            "to": "td004",
            "priority": 30,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "result",
                  "operator": "EQ",
                  "value": "CONNECTED"
                }
              }
            }
          },
          {
            "key": "retry-next",
            "from": "retryResult",
            "to": "end",
            "priority": 20,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "result",
                  "operator": "EQ",
                  "value": "NEXT_WINDOW"
                }
              }
            }
          },
          {
            "key": "retry-exhausted",
            "from": "retryResult",
            "to": "end",
            "priority": 10,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "result",
                  "operator": "EQ",
                  "value": "EXHAUSTED"
                }
              }
            }
          },
          {
            "key": "retry-default",
            "from": "retryResult",
            "to": "end",
            "priority": -1,
            "default": true
          },
          {
            "key": "td004-end",
            "from": "td004",
            "to": "end",
            "priority": 0
          }
        ]
      }
    },
