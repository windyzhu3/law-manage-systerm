{
  "templateCode": "TD-001",
  "templateName": "首联待办",
  "stage": "阶段1-2",
  "businessType": "LEAD",
  "definitionPackageState": "READY",
  "foundationState": "READY",
  "productionState": "READY",
  "definition": {
    "schemaVersion": 1,
    "templateCode": "TD-001",
    "event": {
      "eventType": "LEAD_ASSIGNED",
      "payloadVersion": 1,
      "condition": {}
    },
    "owner": {
      "config": {
        "type": "PAYLOAD",
        "field": "ownerId",
        "skipUnavailable": false,
        "useDelegation": false,
        "requireAvailable": true
      }
    },
    "dod": {
      "config": {
        "requiredFields": [
          "contactResult",
          "contactedAt"
        ],
        "materials": [
          {
            "type": "CONTACT_PROOF",
            "minCount": 1,
            "label": "通话记录、录音或人工补录凭证"
          }
        ],
        "conditionalRequired": [
          {
            "when": {
              "field": "contactResult",
              "equals": "VALID"
            },
            "field": "name"
          },
          {
            "when": {
              "field": "contactResult",
              "equals": "VALID"
            },
            "field": "city"
          },
          {
            "when": {
              "field": "contactResult",
              "equals": "VALID"
            },
            "field": "demand"
          },
          {
            "when": {
              "field": "contactResult",
              "equals": "VALID"
            },
            "field": "visited"
          },
          {
            "when": {
              "field": "contactResult",
              "equals": "SUSPECT_INVALID"
            },
            "field": "invalidReasonCode"
          },
          {
            "when": {
              "field": "contactResult",
              "equals": "SUSPECT_INVALID"
            },
            "field": "salesExplanation"
          }
        ],
        "validatorRefs": [
          "LeadFirstContactValidator"
        ]
      }
    },
    "sla": {
      "config": {
        "calendarCode": "DEFAULT",
        "minutes": 30,
        "thresholds": [
          80,
          100,
          150
        ],
        "thresholdActions": {
          "SLA_80": "REMIND_OWNER",
          "SLA_100": "MARK_OVERDUE_SUPERVISOR_VISIBLE",
          "SLA_150": "ESCALATE_SUPERVISOR"
        }
      }
    },
    "ui": {
      "config": {
        "formCode": "TD-001",
        "businessType": "LEAD",
        "fields": [
          {
            "key": "contactResult",
            "type": "dict",
            "dictType": "law_first_contact_result",
            "label": "首联结果"
          },
          {
            "key": "contactedAt",
            "type": "datetime",
            "label": "联系时间"
          },
          {
            "key": "name",
            "type": "text",
            "label": "姓名",
            "showWhen": {
              "field": "contactResult",
              "equals": "VALID"
            }
          },
          {
            "key": "city",
            "type": "text",
            "label": "城市",
            "showWhen": {
              "field": "contactResult",
              "equals": "VALID"
            }
          },
          {
            "key": "demand",
            "type": "textarea",
            "label": "诉求",
            "showWhen": {
              "field": "contactResult",
              "equals": "VALID"
            }
          },
          {
            "key": "visited",
            "type": "dict",
            "dictType": "law_yes_no_flag",
            "label": "是否到所",
            "showWhen": {
              "field": "contactResult",
              "equals": "VALID"
            }
          },
          {
            "key": "invalidReasonCode",
            "type": "dict",
            "dictType": "law_lead_invalid_reason",
            "label": "无效原因",
            "showWhen": {
              "field": "contactResult",
              "equals": "SUSPECT_INVALID"
            }
          },
          {
            "key": "salesExplanation",
            "type": "textarea",
            "label": "销售说明",
            "showWhen": {
              "field": "contactResult",
              "equals": "SUSPECT_INVALID"
            }
          }
        ]
      }
    },
    "routing": {
      "config": {
        "identityBinding": "MIGRATION_DYNAMIC",
        "start": "td001",
        "releaseDependencies": {
          "TD-003": 3
        },
        "businessOutcomes": [
          {
            "field": "contactResult",
            "value": "VALID",
            "label": "有效",
            "effectKind": "NEXT_TEMPLATE",
            "targetTemplateCode": "TD-004",
            "targetVersionId": 4,
            "businessAction": "WRITE_LEAD_VALID"
          },
          {
            "field": "contactResult",
            "value": "SUSPECT_INVALID",
            "label": "疑似无效",
            "effectKind": "NEXT_TEMPLATE",
            "targetTemplateCode": "TD-002",
            "targetVersionId": 2,
            "businessAction": "MARK_SUSPECT_INVALID"
          },
          {
            "field": "contactResult",
            "value": "UNREACHABLE",
            "label": "无法联系",
            "effectKind": "END",
            "businessAction": "START_RETRY"
          }
        ],
        "nodes": [
          {
            "key": "td001",
            "type": "TASK",
            "templateCode": "TD-001",
            "templateVersionId": 1
          },
          {
            "key": "firstResult",
            "type": "DECISION"
          },
          {
            "key": "td002",
            "type": "TASK",
            "templateCode": "TD-002",
            "templateVersionId": 2
          },
          {
            "key": "reviewResult",
            "type": "DECISION"
          },
          {
            "key": "td004",
            "type": "TASK",
            "templateCode": "TD-004",
            "templateVersionId": 4
          },
          {
            "key": "reopenedTd001",
            "type": "TASK",
            "templateCode": "TD-001",
            "templateVersionId": 1
          },
          {
            "key": "end",
            "type": "END"
          }
        ],
        "edges": [
          {
            "key": "td001-result",
            "from": "td001",
            "to": "firstResult",
            "priority": 0
          },
          {
            "key": "first-valid",
            "from": "firstResult",
            "to": "td004",
            "priority": 30,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "contactResult",
                  "operator": "EQ",
                  "value": "VALID"
                }
              }
            }
          },
          {
            "key": "first-suspect",
            "from": "firstResult",
            "to": "td002",
            "priority": 20,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "contactResult",
                  "operator": "EQ",
                  "value": "SUSPECT_INVALID"
                }
              }
            }
          },
          {
            "key": "first-unreachable",
            "from": "firstResult",
            "to": "end",
            "priority": 10,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "contactResult",
                  "operator": "EQ",
                  "value": "UNREACHABLE"
                }
              }
            }
          },
          {
            "key": "first-default",
            "from": "firstResult",
            "to": "end",
            "priority": -1,
            "default": true
          },
          {
            "key": "td002-result",
            "from": "td002",
            "to": "reviewResult",
            "priority": 0
          },
          {
            "key": "review-invalid",
            "from": "reviewResult",
            "to": "end",
            "priority": 20,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "reviewResult",
                  "operator": "EQ",
                  "value": "TRUE_INVALID"
                }
              }
            }
          },
          {
            "key": "review-reopen",
            "from": "reviewResult",
            "to": "reopenedTd001",
            "priority": 10,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "reviewResult",
                  "operator": "EQ",
                  "value": "MISJUDGED_VALID"
                }
              }
            }
          },
          {
            "key": "review-default",
            "from": "reviewResult",
            "to": "end",
            "priority": -1,
            "default": true
          },
          {
            "key": "reopened-end",
            "from": "reopenedTd001",
            "to": "end",
            "priority": 0
          },
          {
            "key": "td004-end",
            "from": "td004",
            "to": "end",
            "priority": 0
          }
        ]
      }
    },
    "autoActions": [
      {
        "config": {
          "ruleKey": "td001-sla-150",
          "actionType": "ESCALATE",
          "capability": "ESCALATE",
          "triggerAt": "SLA_150",
          "maxAttempts": 3,
          "retryDelayMinutes": 5,
          "claimTimeoutMinutes": 15
        }
      }
    ],
    "decisionRefs": [],
    "acceptanceRefs": [
      "AT-TD-001-OWNER",
      "AT-TD-001-SLA",
      "AT-TD-001-DOD",
      "AT-TD-001-ROUTE",
      "AT-TD-001-HANDLER",
      "AT-TD-001-UI"
    ]
  },
  "routingPlan": {
    "binding": "PUBLISHED_NUMERIC_VERSION",
    "start": "TD-001",
    "transitions": [
      {
        "on": "VALID",
        "to": [
          "TD-004"
        ],
        "businessAction": "WRITE_LEAD_VALID"
      },
      {
        "on": "SUSPECT_INVALID",
        "to": [
          "TD-002"
        ],
        "businessAction": "MARK_SUSPECT_INVALID"
      },
      {
        "on": "UNREACHABLE",
        "to": [
          "END"
        ],
        "businessAction": "START_RETRY"
      }
    ],
    "notes": [
      "UNREACHABLE ends ordinary routing after the business service creates the retry schedule.",
      "Only the schedule materializer may create TD-003."
    ]
  },
  "handlerCapability": {
    "requiredCode": "TD-001_COMPLETE",
    "repositoryStatus": "PRESENT",
    "existingCandidate": "LEAD_FIRST_CONTACT",
    "requireBusinessWriteback": true
  },
  "businessDependencies": [
    {
      "code": "TD001_HANDLER_ALIAS",
      "repositoryStatus": "PRESENT",
      "reason": "TD-001 and legacy LEAD_FIRST_CONTACT are bound to the typed completion handler."
    },
    {
      "code": "OUTBOUND_CALL_ADAPTER",
      "repositoryStatus": "PRESENT",
      "reason": "The governed manual evidence boundary and provider-neutral outbound adapter contract are available."
    }
  ],
  "blockers": [],
  "acceptanceRefs": [
    "AT-TD-001-OWNER",
    "AT-TD-001-SLA",
    "AT-TD-001-DOD",
    "AT-TD-001-ROUTE",
    "AT-TD-001-HANDLER",
    "AT-TD-001-UI"
  ]
}
