{
  "templateCode": "TD-002",
  "templateName": "疑似无效主管复核",
  "stage": "阶段1-2",
  "businessType": "LEAD",
  "definitionPackageState": "READY",
  "foundationState": "READY",
  "productionState": "READY",
  "definition": {
    "schemaVersion": 1,
    "templateCode": "TD-002",
    "event": {
      "eventType": "LEAD_SUSPECT_INVALID_MARKED",
      "payloadVersion": 1,
      "condition": {}
    },
    "owner": {
      "config": {
        "type": "PAYLOAD",
        "field": "reviewerId",
        "skipUnavailable": false,
        "useDelegation": false,
        "requireAvailable": true
      }
    },
    "dod": {
      "config": {
        "requiredFields": [
          "reviewResult",
          "reviewOpinion"
        ],
        "materials": [],
        "conditionalRequired": [],
        "validatorRefs": []
      }
    },
    "sla": {
      "config": {
        "calendarCode": "DEFAULT",
        "minutes": 1440,
        "onDue": "COMPLETE_DEFAULT"
      }
    },
    "ui": {
      "config": {
        "formCode": "TD-002",
        "businessType": "LEAD",
        "fields": [
          {
            "key": "reviewResult",
            "type": "dict",
            "dictType": "law_lead_invalid_review_result",
            "label": "复核结果"
          },
          {
            "key": "reviewOpinion",
            "type": "textarea",
            "label": "复核意见"
          }
        ]
      }
    },
    "routing": {
      "config": {
        "identityBinding": "MIGRATION_DYNAMIC",
        "start": "td002",
        "nodes": [
          {
            "key": "td002",
            "type": "TASK",
            "templateCode": "TD-002",
            "templateVersionId": 2
          },
          {
            "key": "reviewResult",
            "type": "DECISION"
          },
          {
            "key": "reopenedTd001",
            "type": "TASK",
            "templateCode": "TD-001",
            "templateVersionId": 1
          },
          {
            "key": "end",
            "type": "END"
          }
        ],
        "edges": [
          {
            "key": "td002-result",
            "from": "td002",
            "to": "reviewResult",
            "priority": 0
          },
          {
            "key": "review-invalid",
            "from": "reviewResult",
            "to": "end",
            "priority": 20,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "reviewResult",
                  "operator": "EQ",
                  "value": "TRUE_INVALID"
                }
              }
            }
          },
          {
            "key": "review-reopen",
            "from": "reviewResult",
            "to": "reopenedTd001",
            "priority": 10,
            "condition": {
              "$expression": {
                "version": 1,
                "root": {
                  "field": "reviewResult",
                  "operator": "EQ",
                  "value": "MISJUDGED_VALID"
                }
              }
            }
          },
          {
            "key": "review-default",
            "from": "reviewResult",
            "to": "end",
            "priority": -1,
            "default": true
          },
          {
            "key": "reopened-end",
            "from": "reopenedTd001",
            "to": "end",
            "priority": 0
          }
        ]
      }
    },
    "autoActions": [
      {
        "config": {
          "ruleKey": "td002-default-invalid",
          "actionType": "COMPLETE_DEFAULT",
          "capability": "COMPLETE_DEFAULT",
          "triggerAt": "DUE",
          "fields": {
            "reviewResult": "TRUE_INVALID",
            "reviewOpinion": "超过24小时未复核，系统按规则默认确认无效"
          },
          "maxAttempts": 3,
          "retryDelayMinutes": 5,
          "claimTimeoutMinutes": 15
        }
      }
    ],
    "decisionRefs": [],
    "acceptanceRefs": [
      "AT-TD-002-OWNER",
      "AT-TD-002-SLA",
      "AT-TD-002-DOD",
      "AT-TD-002-ROUTE",
      "AT-TD-002-HANDLER",
      "AT-TD-002-UI"
    ]
  },
  "routingPlan": {
    "binding": "PUBLISHED_NUMERIC_VERSION",
    "start": "TD-002",
    "transitions": [
      {
        "on": "TRUE_INVALID",
        "to": [
          "END"
        ],
        "businessAction": "MOVE_DEAD_POOL"
      },
      {
        "on": "MISJUDGED_VALID",
        "to": [
          "TD-001"
        ],
        "businessAction": "REOPEN_FIRST_CONTACT"
      }
    ],
    "notes": [
      "The controlled DUE completion emits the same TRUE_INVALID routing payload as a human confirmation."
    ]
  },
  "handlerCapability": {
    "requiredCode": "TD-002_COMPLETE",
    "repositoryStatus": "PRESENT",
    "existingCandidate": null,
    "requireBusinessWriteback": true
  },
  "businessDependencies": [
    {
      "code": "LEAD_INVALID_REVIEW_EVENT",
      "repositoryStatus": "PRESENT",
      "reason": "The suspect-invalid business fact producer is implemented."
    },
    {
      "code": "LEAD_INVALID_REVIEW_HANDLER",
      "repositoryStatus": "PRESENT",
      "reason": "Human and controlled-automatic review handlers are implemented."
    }
  ],
  "blockers": [],
  "acceptanceRefs": [
    "AT-TD-002-OWNER",
    "AT-TD-002-SLA",
    "AT-TD-002-DOD",
    "AT-TD-002-ROUTE",
    "AT-TD-002-HANDLER",
    "AT-TD-002-UI"
  ]
}
